{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "components/**/*.vue",
    "playground/**/*.ts",
    "playground/**/*.vue",
    "snippets/**/*.ts",
    "snippets/**/*.vue",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
