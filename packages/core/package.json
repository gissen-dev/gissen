    "@vue/test-utils": "^2.4.10",
    "jsdom": "^29.1.1",
    "reka-ui": "^2.9.9",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.8",
    "vue": "^3.5.35",
    "vue-draggable-plus": "^0.6.1"
  }
