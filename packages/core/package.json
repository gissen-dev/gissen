{
  "name": "gissen",
  "type": "module",
  "version": "0.1.0-alpha.3",
  "description": "Headless visual editor and renderer for Vue 3.",
  "license": "MIT",
  "homepage": "https://gissen.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gissen-dev/gissen.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/gissen-dev/gissen/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "page-builder",
    "visual-editor",
    "drag-and-drop",
    "headless",
    "cms",
    "mcp",
    "ai-agent",
    "no-code",
    "open-source"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/gissen.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "nanoid": "^5.1.11",
    "reka-ui": "^2.9.9",
    "vue-draggable-plus": "^0.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.7",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.10",
    "jsdom": "^29.1.1",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.8",
    "vue": "^3.5.35"
  }
}
